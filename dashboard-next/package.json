    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.4",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
